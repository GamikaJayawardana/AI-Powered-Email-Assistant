{
  "name": "AI Email Reply Generator",
  "description": "Generates AI-powered email replies",
  "version": "1.0",
  "manifest_version": 3,
  "action": {
    "default_title": "AI Email Reply Generator",
    "default_icon": "email.png",
    "default_popup": "ext-popup.html"
  },
  "permissions": [
    "storage", 
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8080/*",
    "https://mail.google.com/*"
  ],
  "content_scripts": [
    {
      "js": ["content.js"],
      "matches": ["https://mail.google.com/*"],
      "css": ["content.css"],
      "run_at": "document_idle" 
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://mail.google.com/*"]
    }
  ]
}